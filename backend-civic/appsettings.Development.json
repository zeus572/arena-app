{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "Origins": [
      "http://localhost:5175",
      "https://localhost"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=civic;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "arena-api",
    "Audience": "arena-app",
    "Secret": "PoliticalArenaDevSecretKeyThatIsAtLeast32Characters!!"
  },
  "Auth": {
    "AdminEmails": [ "admin@arena.local" ]
  },
  "DailyGames": {
    // Fork and Time Machine normally land in Draft for a human to approve. On a dev box
    // there's no one working the queue, so auto-approve them locally to get a full slate.
    // DEVELOPMENT ONLY — never set this in appsettings.json or in prod config.
    "AutoApproveReviewedKinds": true,
    "StartupDelaySeconds": 5
  }
}
